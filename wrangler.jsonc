{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "erp-school",
  "main": "src/index.ts",
  "compatibility_date": "2024-11-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./dist/client",
    "binding": "ASSETS"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "erp-school-db",
      "database_id": "cefc74c2-108a-4b10-96c1-e80cbfa1b813"
    }
  ],
  "r2_buckets": [
    {
      "binding": "STORAGE",
      "bucket_name": "erp-school-storage"
    }
  ],
  "vars": {
    "BETTER_AUTH_SECRET": "school-erp-super-secret-key-production-change-me",
    "BETTER_AUTH_URL": "http://localhost:8787"
  }
}
