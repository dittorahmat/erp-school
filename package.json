{
  "name": "erp-school",
  "version": "1.0.0",
  "description": "School ERP Monolith on Cloudflare Workers, D1, R2, and Better-Auth",
  "main": "src/index.ts",
  "directories": {
    "doc": "docs"
  },
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "wrangler d1 execute erp-school-db --local",
    "db:seed:local": "wrangler d1 execute erp-school-db --local --file=./src/db/seed.sql",
    "db:reset:local": "wrangler d1 execute erp-school-db --local --file=./src/db/reset.sql",
    "db:demo:reset": "npm run db:reset:local && npm run db:seed:local",
    "db:migrate:remote": "wrangler d1 execute erp-school-db --remote",
    "db:seed:remote": "wrangler d1 execute erp-school-db --remote --file=./src/db/seed.sql -y",
    "db:reset:remote": "wrangler d1 execute erp-school-db --remote --file=./src/db/reset.sql -y",
    "db:demo:reset:remote": "npm run db:reset:remote && npm run db:seed:remote",
    "deploy": "wrangler deploy",
    "dev": "wrangler dev"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dittorahmat/erp-school.git"
  },
  "keywords": [
    "erp",
    "school",
    "odoo",
    "openeducat",
    "cloudflare-workers",
    "d1",
    "r2"
  ],
  "author": "",
  "license": "ISC",
  "type": "module",
  "bugs": {
    "url": "https://github.com/dittorahmat/erp-school/issues"
  },
  "homepage": "https://github.com/dittorahmat/erp-school#readme",
  "dependencies": {
    "@hono/zod-validator": "^0.9.1",
    "better-auth": "^1.7.13",
    "drizzle-orm": "^0.45.4",
    "hono": "^4.13.14",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261026.1",
    "@types/node": "^26.6.5",
    "drizzle-kit": "^0.31.11",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5",
    "wrangler": "^4.152.0"
  }
}
